# Four nodes (tensor parallelism 4): the settings of T4.md. Copy to glm53.conf next to tf-glm53 and set NODES, the
# network devices and the paths; the rest is the measured configuration.

# The four nodes in rank order, by the address of the RDMA network; run tf-glm53 on the first one.
NODES=(192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14)

# The network interface and RDMA device of that network on every node (`ip -br addr`, `ibv_devices`).
SOCKET_IFNAME=enp1s0f1np1
IB_HCA=rocep1s0f1
GID_INDEX=

# NCCL 2.30.7 at this path on every node (RUNTIME.md, "Before the first start").
NCCL_LIB=~/nccl-2.30.7/nvidia/nccl/lib/libnccl.so.2

# The four-node checkpoint, fiore-lab/GLM-5.3-EXL3-4x-DGX-Sparks on Hugging Face (the 3 / 4-bit expert mix, T4.md),
# the same path on every node.
WEIGHTS=~/models/GLM-5.3-EXL3-4x-DGX-Sparks

# The checkpoint's own MTP layer, or DFlash2 (DRAFTER_KIND=dflash2; not included: CC BY-NC-ND 4.0 for research and
# evaluation, with commercial licensing from Inco AI; RUNTIME.md, "Using DFlash2").
DRAFTER_KIND=mtp
MTP_K=3
DRAFTER=
#DRAFTER=~/models/GLM-5.3-DFlash2

# The server. With HOST other than loopback and no API_KEY_FILE the API is open to anyone who can reach it; set
# API_KEY_FILE to require a key, and put TLS or a closed network in front.
NAME=glm-5.3
HOST=127.0.0.1
PORT=8000
API_KEY_FILE=
# A monitor on another host: rank 0 also answers GET /metrics (Prometheus text) and /health at this HOST:PORT,
# read-only and without a key, while the API stays on HOST. Empty: off. Keep it on a closed network.
#METRICS_LISTEN=0.0.0.0:9894

# The measured configuration: 737,280 positions a request (prompt + reply), 100,000 more kept for earlier
# conversations (the pool holds 837,280 positions in blocks of 256 that every conversation shares), decode context
# parallelism 2, prompt chunks of 16,384 rows in 4 sequence-parallel parts, the 4-bit KV cache.
CONTEXT=737280
STORE=100000
CACHE=pool
DCP=2
ROWS=16384
SP_PARTS=4
KV=fp4
# The memory a node must have available before the start: tf-glm53 check asks NEED_GB minus 2.7 GiB for each
# 100,000 positions of STORE below 819,200 (the eight-node measure), plus 3 with DFlash2; 131 makes it 112 GiB here
# (115 with DFlash2), what four nodes use.
NEED_GB=131

MASTER_PORT=29551
READY_TIMEOUT=900

# Several conversations decoded together: off by default (requests run one at a time, as in r2-102). To keep up to
# 4 conversations live and decode them in one window a round, set EXTRA_ENV="TF_GLM53_MULTI=4" (needs CACHE=pool,
# DCP=2 and DFlash2 or no drafter; MTP is not batched). It costs node memory: check the available memory with 4 long
# conversations before using it.
#EXTRA_ENV="TF_GLM53_MULTI=4"

# The control panel, Expert Atlas (RUNTIME.md, "The control panel"): `./tf-glm53 launcher` serves it at
# http://LAUNCHER_HOST:LAUNCHER_PORT/panel, and starts and stops the engine with the routed experts' widths chosen
# there, from the banks listed in expert-plan/banks.json. Loopback by default: from another machine use ssh -L, or set
# LAUNCHER_HOST and API_KEY_FILE. ATLAS_DIR keeps the saved allocations (default: atlas/ in this directory). With
# TF_GLM53_MULTI the engine changes no expert's width while it runs; expert optimisation then saves the allocation
# for the next start.
LAUNCHER_HOST=127.0.0.1
LAUNCHER_PORT=8010
#ATLAS_DIR=
# What a node keeps for the OS after a start from the panel, in GiB (the launch screen may pick another a start).
RESERVE_GB=4
